{
  "schema_version": 1,
  "title": "Reperio design tokens",
  "description": "Versioned source of truth for the Reperio web UI design system. Every color, spacing, typography and radius value used by the UI must come from this file; tokens.css and catalog.html derive from it. Values are chosen for WCAG 2.1 AA contrast in both light and dark themes and contain no third-party branding.",
  "colors": {
    "bg": { "light": "#f7f8fa", "dark": "#111318" },
    "surface": { "light": "#ffffff", "dark": "#1b1e24" },
    "surface-raised": { "light": "#ffffff", "dark": "#242832" },
    "border": { "light": "#d5d9e0", "dark": "#3a3f4a" },
    "text-primary": { "light": "#1a1c20", "dark": "#e8eaed" },
    "text-secondary": { "light": "#5b616e", "dark": "#a8adb8" },
    "action": { "light": "#2f6fdb", "dark": "#7aa5f0" },
    "action-text": { "light": "#ffffff", "dark": "#111318" },
    "danger": { "light": "#c0392b", "dark": "#f1948a" },
    "success": { "light": "#1e8449", "dark": "#7fd6a0" },
    "warning": { "light": "#8a5a00", "dark": "#f0c674" },
    "focus-ring": { "light": "#2f6fdb", "dark": "#7aa5f0" }
  },
  "typography": {
    "font-family": {
      "value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
    },
    "scale": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "20px",
      "xl": "28px"
    },
    "weights": { "regular": "400", "medium": "500", "bold": "700" }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px"
  },
  "radii": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "9999px"
  },
  "status": {
    "pending": { "light": "#5b616e", "dark": "#a8adb8" },
    "running": { "light": "#2f6fdb", "dark": "#7aa5f0" },
    "completed": { "light": "#1e8449", "dark": "#7fd6a0" },
    "warning": { "light": "#8a5a00", "dark": "#f0c674" },
    "failed": { "light": "#c0392b", "dark": "#f1948a" }
  },
  "contrastPairs": [
    { "fg": "action-text", "bg": "action", "minRatio": 4.5 },
    { "fg": "text-primary", "bg": "surface", "minRatio": 4.5 },
    { "fg": "text-primary", "bg": "bg", "minRatio": 4.5 },
    { "fg": "text-secondary", "bg": "surface", "minRatio": 4.5 },
    { "fg": "danger", "bg": "surface", "minRatio": 4.5 },
    { "fg": "success", "bg": "surface", "minRatio": 4.5 },
    { "fg": "warning", "bg": "surface", "minRatio": 4.5 }
  ]
}
