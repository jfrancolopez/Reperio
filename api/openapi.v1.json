{
  "components": {
    "schemas": {
      "CaseActionRequest": {
        "properties": {
          "reason": {
            "default": "operator request",
            "title": "Reason",
            "type": "string"
          }
        },
        "title": "CaseActionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SourcePreviewRequest": {
        "properties": {
          "observed_generation": {
            "minimum": 0.0,
            "title": "Observed Generation",
            "type": "integer"
          },
          "scan_policy": {
            "additionalProperties": true,
            "title": "Scan Policy",
            "type": "object"
          }
        },
        "required": [
          "observed_generation"
        ],
        "title": "SourcePreviewRequest",
        "type": "object"
      },
      "StartScanRequest": {
        "properties": {
          "observed_generation": {
            "minimum": 0.0,
            "title": "Observed Generation",
            "type": "integer"
          },
          "operator_confirmation_token": {
            "title": "Operator Confirmation Token",
            "type": "string"
          },
          "resource_profile": {
            "default": "default",
            "title": "Resource Profile",
            "type": "string"
          },
          "safety_inspection_id": {
            "title": "Safety Inspection Id",
            "type": "string"
          },
          "scan_policy": {
            "additionalProperties": true,
            "title": "Scan Policy",
            "type": "object"
          },
          "scratch_separation_id": {
            "title": "Scratch Separation Id",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "observed_generation",
          "safety_inspection_id",
          "operator_confirmation_token",
          "scratch_separation_id"
        ],
        "title": "StartScanRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
